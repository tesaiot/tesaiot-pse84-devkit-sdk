+++ b/aws-iot-device-sdk-port/release-v2.7.0/source/COMPONENT_SECURE_SOCKETS/cy_aws_tcpip_port_secure_sockets.c	2026-03-28 21:25:46.000000000 +0700
@@ -393,13 +393,16 @@
