/******************************************************************************
* File Name:   tesaiot_root_ca.h
*
* Description: TESAIoT Platform Intermediate CA certificate for TLS server
*              verification. Used by mqtt_client_config.c for MQTT broker
*              authentication.
*
*              We pin to the Intermediate CA (RSA-2048) rather than the Root CA
*              (RSA-4096) because RSA-4096 signature verification requires more
*              heap than available on PSoC Edge during TLS handshake.
*              The Intermediate CA directly signs mqtt.tesaiot.com — pinning to
*              it is valid and provides tighter trust than Root CA pinning.
*
*              PKI chain: Root CA (RSA-4096) → Intermediate CA (RSA-2048) → server
*              Server presents [server cert, Intermediate CA] in TLS handshake.
*              We verify: server cert ← Intermediate CA (our trust anchor).
*
* Usage:
*   security_info.root_ca = TESAIOT_ROOT_CA_CERTIFICATE;
*   security_info.root_ca_size = sizeof(TESAIOT_ROOT_CA_CERTIFICATE);
******************************************************************************/

#ifndef TESAIOT_ROOT_CA_H
#define TESAIOT_ROOT_CA_H

